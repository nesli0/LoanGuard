# ============================================
# LoanGuard - Ortam Değişkenleri Şablonu
# ============================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
# ============================================

# Uygulama
APP_ENV=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# Veri yolları
DATA_RAW_PATH=data/raw/
DATA_PROCESSED_PATH=data/processed/
MODELS_PATH=models/

# Model versiyon
MODEL_VERSION=v1.0
