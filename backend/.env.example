# ============================================================
# LoanGuard Backend — Ortam Değişkenleri Şablonu
# ============================================================
# Kopyala ve değerleri doldur:
#   cp .env.example .env
#
# ⚠️  Docker ile çalıştırıyorsan:
#   DATABASE_URL'deki host "localhost" değil "db" olmalı
#   (db = docker-compose'daki PostgreSQL servisinin adı)
# ============================================================

# ── Veritabanı ───────────────────────────────────────────────
# Docker ile:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/Loanguard
# Lokalde (Docker olmadan) çalıştırıyorsan:
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/Loanguard

# ── PostgreSQL (docker-compose tarafından kullanılır) ────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=Loanguard

# ── Güvenlik ────────────────────────────────────────────────
JWT_SECRET_KEY=your-256-bit-secret-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# ── Uygulama ────────────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── LLM ─────────────────────────────────────────────────────
GEMINI_API=your-gemini-api-key-here

# ── ML Model Yolları (opsiyonel, varsayılan kullanılır) ──────
# LOANGUARD_MODEL_PATH=/app/models
# LOANGUARD_DATA_DIR=/app/data/interim
